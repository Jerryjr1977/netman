# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is gitignored.

# AI provider keys (only the ones you use are required)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Your personal ngrok domain (used for OOB/exfil payloads in the Intruder)
# Example: kasen-unhewable-bill.ngrok-free.dev
NGROK_DOMAIN=your_ngrok_domain_here
