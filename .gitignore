http_history.log
proxy_debug.log
proxy_debug.log.*
debug_response.html
response.http
modified_request.http
*.log
*.http
# Firefox telemetry capture file
GET*

# ── VS Code workspace files (contain machine-local paths) ─────────────────────
*.code-workspace

# ── Python artifacts ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── OS artifacts ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Google Drive temp folders ──────────────────────────────────────────────────
.tmp.drivedownload/
.tmp.driveupload/

